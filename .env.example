# Copy this file to .env and fill in your own values. Never commit .env.

# Supabase: Project Settings → API (the publishable / anon key, NOT the secret key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-publishable-or-anon-key

# Optional: turns on AI answers in the Virtual Notebook and AI study plans.
# Pick a provider: gemini (free tier, good for demos) or anthropic (Claude, paid).
AI_PROVIDER=gemini

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Turned on billing for this key? Set this to hide the "Demo AI" free-tier note in the notebook.
# GEMINI_PAID=true

# Paid key: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here
